# =============================================================================
# ServerSpot Environment Configuration
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- Core ---
NODE_ENV=development
SKIP_ENV_VALIDATION=false

# --- Database (required) ---
DATABASE_URL=postgresql://serverspot:serverspot@localhost:5432/serverspot

# --- Auth (required) ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-at-least-32-characters-long
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PayPal (optional) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Discord (optional) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# --- Storage ---
UPLOAD_DIR=./uploads

# --- Game Gateway (optional) ---
GAME_GATEWAY_URL=http://localhost:3001
GAME_GATEWAY_PORT=3001
GAME_GATEWAY_SECRET=

# --- Logging ---
LOG_LEVEL=debug
